# ===== LLM: DeepSeek（决策层：Agent 3 / Agent 5）=====
DEEPSEEK_API_KEY=your-deepseek-api-key

# ===== LangSmith 可观测性（开发期保持 false，里程碑 4 起改为 true）=====
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=fingerstyle-agent

# ===== PostgreSQL（短期记忆 Checkpointer，里程碑 8 使用）=====
# 宿主机调试用 localhost；Docker 容器内由 compose 覆盖为服务名
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=fingerstyle
POSTGRES_PASSWORD=fingerstyle_dev_pw
POSTGRES_DB=fingerstyle

# ===== Redis（长期记忆 Store，里程碑 8 使用）=====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== Chroma（RAG 向量库，里程碑 5 使用）=====
# 宿主机调试用 localhost:8001；Docker 容器内由 compose 覆盖为 chromadb:8000
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ===== 应用 =====
LOG_LEVEL=INFO
